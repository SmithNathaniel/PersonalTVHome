<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only: weather, wallpapers and artwork never travel over plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
